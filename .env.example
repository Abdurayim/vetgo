# VetGo environment — copy to .env.local and fill in values

# Backend URL (Vite proxy routes /api/* here in dev)
VITE_API_BASE_URL=/api

# Mock auth: set to "true" while the backend isn't ready.
# Role is determined by email prefix: admin@*, vet@*, seller@*, other → pet_owner
VITE_MOCK_AUTH=true

# GitHub Pages base path (injected automatically by the deploy workflow — do not set manually)
# VITE_BASE=/vet/
